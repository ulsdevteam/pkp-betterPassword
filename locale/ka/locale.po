msgid "plugins.generic.betterPassword.displayName"
msgstr "უკეთესი პაროლის მოდული"

msgid "plugins.generic.betterPassword.description"
msgstr ""
"პაროლის დამატებითი მოთხოვნების ჩართვა PKP პროგრამული უზრუნველყოფის "
"ფარგლებში.  იძლევა NIST რეკომენდაციების განხორციელების საშუალებას."

msgid "plugins.generic.betterPassword.validation.betterPasswordCheckAlpha"
msgstr "თქვენი პაროლი მოითხოვს ანბანურ სიმბოლოს."

msgid "plugins.generic.betterPassword.validation.betterPasswordCheckUppercase"
msgstr "თქვენი პაროლი მოითხოვს დიდ ასოებს."

msgid "plugins.generic.betterPassword.validation.betterPasswordCheckLowercase"
msgstr "თქვენი პაროლი მოითხოვს მცირე ასოს."

msgid "plugins.generic.betterPassword.validation.betterPasswordCheckNumber"
msgstr "თქვენი პაროლი მოითხოვს ციფრულ სიმბოლოს."

msgid "plugins.generic.betterPassword.validation.betterPasswordCheckSpecial"
msgstr "თქვენი პაროლი მოითხოვს არაალფანუმერულ სიმბოლოს."

msgid "plugins.generic.betterPassword.validation.betterPasswordCheckBlocklist"
msgstr "თქვენი პაროლი ნაპოვნი იქნა ცნობილი ცუდი პაროლების ბლოკ სიაში."

msgid "plugins.generic.betterPassword.validation.betterPasswordLocked"
msgstr "თქვენი ანგარიში დროებით დაიბლოკა პაროლის არასწორი მცდელობის გამო."

msgid ""
"plugins.generic.betterPassword.validation.betterPasswordUnexpectedError"
msgstr "თქვენი პაროლი ამჯერად ვერ შეიცვლება.  გთხოვთ, სცადოთ მოგვიანებით."

msgid "plugins.generic.betterPassword.validation.betterPasswordPasswordReused"
msgstr ""
"თქვენ არ შეგიძლიათ ამ პაროლის ხელახლა გამოყენება, გთხოვთ, აირჩიოთ სხვა."

msgid "plugins.generic.betterPassword.manager.settings"
msgstr "პარამეტრები"

msgid ""
"plugins.generic.betterPassword.manager.settings.betterPasswordUploadFail"
msgstr "ფაილის ატვირთვა ვერ მოხერხდა"

msgid ""
"plugins.generic.betterPassword.manager.settings.betterPasswordDeleteFail"
msgstr "ფაილის წაშლა ვერ მოხერხდა"

msgid "plugins.generic.betterPassword.manager.betterPasswordSettings"
msgstr "პაროლის უკეთესი პარამეტრები"

msgid "plugins.generic.betterPassword.manager.settings.description"
msgstr ""
"<p>ამ მოდულის ჩართვის შემთხვევაში, მომხმარებლის პაროლები შემოწმდება "
"დამატებითი კრიტერიუმების შესაბამისად, რათა უზრუნველყოფილ იქნას პაროლის "
"უკეთესი შერჩევა.  NIST რეკომენდაციას უწევს პაროლების შემოწმებას დაბლოკვის "
"სიის მიხედვით და გამოიყენეთ ანგარიშის დროებითი ჩაკეტვა პაროლის განმეორებითი "
"წარუმატებლობის შემდეგ.  სირთულის მოთხოვნები, მათ შორის ალფანუმერული "
"სიმბოლოების კონკრეტული ტიპები, ხელმისაწვდომია, მაგრამ არ არის რეკომენდებული "
"UX მიზეზების გამო.</p>"

