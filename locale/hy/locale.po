msgstr ""
"Վերջին գաղտնաբառերի քանակը, որոնք պետք է արգելափակվեն կրկնակի օգտագործման "
"համար:"

msgid ""
"plugins.generic.betterPassword.manager.settings.betterPasswordInvalidationDaysNumberRequired"
msgstr "Գաղտնաբառերի ժամկետի ավարտից առաջ օրերի թիվը պետք է լինի թվային:"

msgid ""
"plugins.generic.betterPassword.manager.settings.betterPasswordInvalidationPasswordsNumberRequired"
msgstr ""
"Վերջին գաղտնաբառերի թիվը, որոնք պետք է արգելափակվեն կրկնակի օգտագործման "
"համար, պետք է թվային լինեն:"

msgid ""
"plugins.generic.betterPassword.manager.settings.betterPasswordInvalidationMininumWarningDaysNumberRequired"
msgstr ""
"Օրերի քանակը, մինչև ժամկետի ավարտը, գաղտնաբառի ժամկետի լրանալու մասին "
"օգտվողին ամեն օր նախազգուշացնելու համար պետք է լինի թվային:"

msgid "plugins.generic.betterPassword.message.yourPasswordWillExpire"
msgstr "Ձեր գաղտնաբառը սպառվելու է {$days} օրից:"

msgid "plugins.generic.betterPassword.actions.deleteBlocklist"
msgstr "Ջնջել առկա արգելափակման ցուցակը"

msgid "plugins.generic.betterPassword.actions.deleteBlocklistCheck"
msgstr "Իսկապե՞ս ուզում եք ջնջել:"
