msgid "plugins.generic.betterPassword.displayName"
msgstr "Connector Better Password"

msgid "plugins.generic.betterPassword.description"
msgstr "Activa requisits addicionals de contrasenya al programari de la PKP. Permet implementar les recomanacions del NIST."

msgid "plugins.generic.betterPassword.validation.betterPasswordCheckAlpha"
msgstr "La vostra contrasenya ha de contenir un caràcter alfabètic."

msgid "plugins.generic.betterPassword.validation.betterPasswordCheckUppercase"
msgstr "La vostra contrasenya ha de contenir un caràcter en majúscula."

msgid "plugins.generic.betterPassword.validation.betterPasswordCheckLowercase"
msgstr "La vostra contrasenya ha de contenir un caràcter en minúscula."

msgid "plugins.generic.betterPassword.validation.betterPasswordCheckNumber"
msgstr "La vostra contrasenya ha de contenir un caràcter numèric."

msgid "plugins.generic.betterPassword.validation.betterPasswordCheckSpecial"
msgstr "La vostra contrasenya ha de contenir un caràcter no alfanumèric."

msgid "plugins.generic.betterPassword.validation.betterPasswordCheckBlocklist"
msgstr "La vostra contrasenya s'ha trobat en una llista de contrasenyes compromeses conegudes."

msgid "plugins.generic.betterPassword.validation.betterPasswordLocked"
msgstr "El vostre compte s'ha bloquejat temporalment a causa d'intents d'inici de sessió incorrectes."

msgid "plugins.generic.betterPassword.validation.betterPasswordUnexpectedError"
msgstr "No s'ha pogut canviar la vostra contrasenya en aquest moment. Torneu-ho a provar més tard."

msgid "plugins.generic.betterPassword.validation.betterPasswordPasswordReused"
msgstr "No podeu reutilitzar aquesta contrasenya; trieu-ne una altra."

msgid "plugins.generic.betterPassword.validation.requirementsNotMet"
msgstr "La vostra contrasenya no compleix els requisits següents:\n{$requirements}"

msgid "plugins.generic.betterPassword.description.requirementsHeading"
msgstr "Requisits de la contrasenya:"

msgid "plugins.generic.betterPassword.requirement.length"
msgstr "tenir com a mínim {$length} caràcters"

msgid "plugins.generic.betterPassword.requirement.alpha"
msgstr "contenir un caràcter alfabètic"

msgid "plugins.generic.betterPassword.requirement.uppercase"
msgstr "contenir un caràcter en majúscula"

msgid "plugins.generic.betterPassword.requirement.lowercase"
msgstr "contenir un caràcter en minúscula"

msgid "plugins.generic.betterPassword.requirement.number"
msgstr "contenir un caràcter numèric"

msgid "plugins.generic.betterPassword.requirement.special"
msgstr "contenir un caràcter no alfanumèric"

msgid "plugins.generic.betterPassword.requirement.blocklist"
msgstr "no ser una contrasenya d'ús comú o coneguda com a compromesa"

msgid "plugins.generic.betterPassword.requirement.noReuse"
msgstr "no coincidir amb cap de les vostres últimes {$count} contrasenyes"

msgid "plugins.generic.betterPassword.manager.settings"
msgstr "Configuració"

msgid "plugins.generic.betterPassword.manager.settings.betterPasswordUploadFail"
msgstr "No s'ha pogut carregar el fitxer"

msgid "plugins.generic.betterPassword.manager.settings.betterPasswordDeleteFail"
msgstr "No s'ha pogut eliminar el fitxer"

msgid "plugins.generic.betterPassword.manager.betterPasswordSettings"
msgstr "Configuració de Better Password"

msgid "plugins.generic.betterPassword.manager.settings.description"
msgstr "<p>Amb aquest connector activat, les contrasenyes dels usuaris i les usuàries es comprovaran amb criteris addicionals per garantir una millor tria de contrasenyes. El NIST recomana comparar les contrasenyes amb una llista de bloqueig i utilitzar el bloqueig temporal de comptes després de diversos errors. Els requisits de complexitat, inclosos tipus específics de caràcters alfanumèrics, estan disponibles, però no es recomanen per motius d'experiència d'usuari.</p>"

msgid "plugins.generic.betterPassword.manager.settings.betterPasswordCheckTitle"
msgstr "Requisits de la contrasenya"

msgid "plugins.generic.betterPassword.manager.settings.betterPasswordBlocklist"
msgstr "Carrega el fitxer de la llista de bloqueig"

msgid "plugins.generic.betterPassword.manager.settings.betterPasswordExistingBlocklist"
msgstr "Llistes de bloqueig carregades"

msgid "plugins.generic.betterPassword.manager.settings.betterPasswordCheckAlpha"
msgstr "Exigeix un caràcter alfabètic."

msgid "plugins.generic.betterPassword.manager.settings.betterPasswordCheckUppercase"
msgstr "Exigeix un caràcter en majúscula."

msgid "plugins.generic.betterPassword.manager.settings.betterPasswordCheckLowercase"
msgstr "Exigeix un caràcter en minúscula."

msgid "plugins.generic.betterPassword.manager.settings.betterPasswordCheckNumber"
msgstr "Exigeix un caràcter numèric."

msgid "plugins.generic.betterPassword.manager.settings.betterPasswordCheckSpecial"
msgstr "Exigeix un caràcter no alfanumèric."

msgid "plugins.generic.betterPassword.manager.settings.betterPasswordCheckBlacklist"
msgstr "Comprova totes les contrasenyes sol·licitades pels usuaris i les usuàries amb una llista de contrasenyes compromeses conegudes."

msgid "plugins.generic.betterPassword.manager.settings.betterPasswordLockTitle"
msgstr "Bloqueig temporal de compte"

msgid "plugins.generic.betterPassword.manager.settings.betterPasswordLockTries"
msgstr "Nombre d'intents d'inici de sessió incorrectes a partir del qual es bloqueja un compte."

msgid "plugins.generic.betterPassword.manager.settings.betterPasswordLockExpires"
msgstr "Nombre de segons abans d'oblidar els intents d'inici de sessió incorrectes."

msgid "plugins.generic.betterPassword.manager.settings.betterPasswordLockSeconds"
msgstr "Nombre de segons durant els quals es bloqueja un compte després d'un excés d'intents d'inici de sessió incorrectes."

msgid "plugins.generic.betterPassword.manager.settings.betterPasswordLockRequired"
msgstr "Si s'introdueix qualsevol configuració de bloqueig temporal de compte, totes les configuracions de bloqueig temporal són obligatòries."

msgid "plugins.generic.betterPassword.manager.settings.betterPasswordLockTriesNumberRequired"
msgstr "El nombre d'intents d'inici de sessió incorrectes a partir del qual es bloqueja un compte ha de ser numèric."

msgid "plugins.generic.betterPassword.manager.settings.betterPasswordLockExpiresNumberRequired"
msgstr "El nombre de segons abans d'oblidar els intents d'inici de sessió incorrectes ha de ser numèric."

msgid "plugins.generic.betterPassword.manager.settings.betterPasswordLockSecondsNumberRequired"
msgstr "El nombre de segons durant els quals es bloqueja un compte després d'un excés d'intents d'inici de sessió incorrectes ha de ser numèric."

msgid "plugins.generic.betterPassword.manager.settings.betterPasswordInvalidationTitle"
msgstr "Invalidació de la contrasenya"

msgid "plugins.generic.betterPassword.manager.settings.betterPasswordInvalidationDays"
msgstr "Nombre de dies abans que caduquin les contrasenyes."

msgid "plugins.generic.betterPassword.manager.settings.betterPasswordInvalidationMininumWarningDays"
msgstr "Nombre de dies, abans de la caducitat, a partir del qual començar a avisar diàriament l'usuari o usuària sobre la caducitat de la contrasenya."

msgid "plugins.generic.betterPassword.manager.settings.betterPasswordInvalidationPasswords"
msgstr "Nombre d'últimes contrasenyes que s'han de bloquejar per evitar la reutilització."

msgid "plugins.generic.betterPassword.manager.settings.betterPasswordInvalidationDaysNumberRequired"
msgstr "El nombre de dies abans que caduquin les contrasenyes ha de ser numèric."

msgid "plugins.generic.betterPassword.manager.settings.betterPasswordInvalidationPasswordsNumberRequired"
msgstr "El nombre d'últimes contrasenyes que s'han de bloquejar per evitar la reutilització ha de ser numèric."

msgid "plugins.generic.betterPassword.manager.settings.betterPasswordInvalidationMininumWarningDaysNumberRequired"
msgstr "El nombre de dies, abans de la caducitat, a partir del qual començar a avisar diàriament l'usuari o usuària sobre la caducitat de la contrasenya ha de ser numèric."

msgid "plugins.generic.betterPassword.message.yourPasswordWillExpire"
msgstr "La vostra contrasenya caducarà en {$days} dia/es."

msgid "plugins.generic.betterPassword.actions.deleteBlocklist"
msgstr "Elimina la llista de bloqueig existent"

msgid "plugins.generic.betterPassword.actions.deleteBlocklistCheck"
msgstr "Esteu segur/a que ho voleu eliminar?"
