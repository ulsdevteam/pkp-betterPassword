msgid "plugins.generic.betterPassword.displayName"
msgstr "Πρόσθετο Better Password"

msgid "plugins.generic.betterPassword.description"
msgstr "Ενεργοποιεί πρόσθετες απαιτήσεις κωδικών πρόσβασης στο λογισμικό του PKP. Επιτρέπει την εφαρμογή των συστάσεων του NIST."

msgid "plugins.generic.betterPassword.validation.betterPasswordCheckAlpha"
msgstr "Ο κωδικός πρόσβασής σας πρέπει να περιέχει έναν αλφαβητικό χαρακτήρα."

msgid "plugins.generic.betterPassword.validation.betterPasswordCheckUppercase"
msgstr "Ο κωδικός πρόσβασής σας πρέπει να περιέχει έναν κεφαλαίο χαρακτήρα."

msgid "plugins.generic.betterPassword.validation.betterPasswordCheckLowercase"
msgstr "Ο κωδικός πρόσβασής σας πρέπει να περιέχει έναν πεζό χαρακτήρα."

msgid "plugins.generic.betterPassword.validation.betterPasswordCheckNumber"
msgstr "Ο κωδικός πρόσβασής σας πρέπει να περιέχει έναν αριθμητικό χαρακτήρα."

msgid "plugins.generic.betterPassword.validation.betterPasswordCheckSpecial"
msgstr "Ο κωδικός πρόσβασής σας πρέπει να περιέχει έναν μη αλφαριθμητικό χαρακτήρα."

msgid "plugins.generic.betterPassword.validation.betterPasswordCheckBlocklist"
msgstr "Ο κωδικός πρόσβασής σας βρέθηκε σε λίστα γνωστών παραβιασμένων κωδικών πρόσβασης."

msgid "plugins.generic.betterPassword.validation.betterPasswordLocked"
msgstr "Ο λογαριασμός σας έχει κλειδωθεί προσωρινά λόγω εσφαλμένων προσπαθειών κωδικού πρόσβασης."

msgid "plugins.generic.betterPassword.validation.betterPasswordUnexpectedError"
msgstr "Ο κωδικός πρόσβασής σας δεν μπόρεσε να αλλάξει αυτή τη στιγμή. Παρακαλώ δοκιμάστε ξανά αργότερα."

msgid "plugins.generic.betterPassword.validation.betterPasswordPasswordReused"
msgstr "Δεν μπορείτε να επαναχρησιμοποιήσετε αυτόν τον κωδικό πρόσβασης, παρακαλώ επιλέξτε άλλον."

msgid "plugins.generic.betterPassword.validation.requirementsNotMet"
msgstr "Ο κωδικός πρόσβασής σας δεν πληροί τις ακόλουθες απαιτήσεις:\n{$requirements}"

msgid "plugins.generic.betterPassword.description.requirementsHeading"
msgstr "Απαιτήσεις κωδικού πρόσβασης:"

msgid "plugins.generic.betterPassword.requirement.length"
msgstr "να έχει μήκος τουλάχιστον {$length} χαρακτήρες"

msgid "plugins.generic.betterPassword.requirement.alpha"
msgstr "να περιέχει έναν αλφαβητικό χαρακτήρα"

msgid "plugins.generic.betterPassword.requirement.uppercase"
msgstr "να περιέχει έναν κεφαλαίο χαρακτήρα"

msgid "plugins.generic.betterPassword.requirement.lowercase"
msgstr "να περιέχει έναν πεζό χαρακτήρα"

msgid "plugins.generic.betterPassword.requirement.number"
msgstr "να περιέχει έναν αριθμητικό χαρακτήρα"

msgid "plugins.generic.betterPassword.requirement.special"
msgstr "να περιέχει έναν μη αλφαριθμητικό χαρακτήρα"

msgid "plugins.generic.betterPassword.requirement.blocklist"
msgstr "να μην είναι ένας συνηθισμένος ή γνωστός παραβιασμένος κωδικός πρόσβασης"

msgid "plugins.generic.betterPassword.requirement.noReuse"
msgstr "να μην ταιριάζει με κανέναν από τους τελευταίους {$count} κωδικούς πρόσβασής σας"

msgid "plugins.generic.betterPassword.manager.settings"
msgstr "Ρυθμίσεις"

msgid "plugins.generic.betterPassword.manager.settings.betterPasswordUploadFail"
msgstr "Αποτυχία μεταφόρτωσης αρχείου"

msgid "plugins.generic.betterPassword.manager.settings.betterPasswordDeleteFail"
msgstr "Αποτυχία διαγραφής αρχείου"

msgid "plugins.generic.betterPassword.manager.betterPasswordSettings"
msgstr "Ρυθμίσεις Better Password"

msgid "plugins.generic.betterPassword.manager.settings.description"
msgstr "<p>Με αυτό το πρόσθετο ενεργοποιημένο, οι κωδικοί πρόσβασης των χρηστών θα ελέγχονται σύμφωνα με πρόσθετα κριτήρια ώστε να εξασφαλίζεται καλύτερη επιλογή κωδικών. Το NIST συνιστά τον έλεγχο των κωδικών πρόσβασης έναντι μιας λίστας αποκλεισμού και τη χρήση προσωρινού κλειδώματος λογαριασμού μετά από επαναλαμβανόμενες αποτυχημένες προσπάθειες κωδικού. Οι απαιτήσεις πολυπλοκότητας, συμπεριλαμβανομένων συγκεκριμένων τύπων αλφαριθμητικών χαρακτήρων, είναι διαθέσιμες αλλά δεν συνιστώνται για λόγους εμπειρίας χρήστη.</p>"

msgid "plugins.generic.betterPassword.manager.settings.betterPasswordCheckTitle"
msgstr "Απαιτήσεις κωδικού πρόσβασης"

msgid "plugins.generic.betterPassword.manager.settings.betterPasswordBlocklist"
msgstr "Μεταφορτώστε το αρχείο λίστας αποκλεισμού"

msgid "plugins.generic.betterPassword.manager.settings.betterPasswordExistingBlocklist"
msgstr "Μεταφορτωμένες λίστες αποκλεισμού"

msgid "plugins.generic.betterPassword.manager.settings.betterPasswordCheckAlpha"
msgstr "Απαίτηση αλφαβητικού χαρακτήρα."

msgid "plugins.generic.betterPassword.manager.settings.betterPasswordCheckUppercase"
msgstr "Απαίτηση κεφαλαίου χαρακτήρα."

msgid "plugins.generic.betterPassword.manager.settings.betterPasswordCheckLowercase"
msgstr "Απαίτηση πεζού χαρακτήρα."

msgid "plugins.generic.betterPassword.manager.settings.betterPasswordCheckNumber"
msgstr "Απαίτηση αριθμητικού χαρακτήρα."

msgid "plugins.generic.betterPassword.manager.settings.betterPasswordCheckSpecial"
msgstr "Απαίτηση μη αλφαριθμητικού χαρακτήρα."

msgid "plugins.generic.betterPassword.manager.settings.betterPasswordCheckBlacklist"
msgstr "Έλεγχος όλων των κωδικών πρόσβασης που ζητούν οι χρήστες έναντι μιας λίστας γνωστών παραβιασμένων κωδικών πρόσβασης."

msgid "plugins.generic.betterPassword.manager.settings.betterPasswordLockTitle"
msgstr "Προσωρινό κλείδωμα λογαριασμού"

msgid "plugins.generic.betterPassword.manager.settings.betterPasswordLockTries"
msgstr "Αριθμός εσφαλμένων προσπαθειών σύνδεσης μετά τις οποίες κλειδώνεται ένας λογαριασμός."

msgid "plugins.generic.betterPassword.manager.settings.betterPasswordLockExpires"
msgstr "Αριθμός δευτερολέπτων πριν τη λήθη των εσφαλμένων προσπαθειών σύνδεσης."

msgid "plugins.generic.betterPassword.manager.settings.betterPasswordLockSeconds"
msgstr "Αριθμός δευτερολέπτων για το κλείδωμα ενός λογαριασμού μετά από υπερβολικές εσφαλμένες προσπάθειες σύνδεσης."

msgid "plugins.generic.betterPassword.manager.settings.betterPasswordLockRequired"
msgstr "Εάν εισαχθεί οποιαδήποτε ρύθμιση προσωρινού κλειδώματος λογαριασμού, απαιτούνται όλες οι ρυθμίσεις προσωρινού κλειδώματος λογαριασμού."

msgid "plugins.generic.betterPassword.manager.settings.betterPasswordLockTriesNumberRequired"
msgstr "Ο αριθμός εσφαλμένων προσπαθειών σύνδεσης για το κλείδωμα ενός λογαριασμού πρέπει να είναι αριθμητική τιμή."

msgid "plugins.generic.betterPassword.manager.settings.betterPasswordLockExpiresNumberRequired"
msgstr "Ο αριθμός δευτερολέπτων πριν τη λήθη των εσφαλμένων προσπαθειών σύνδεσης πρέπει να είναι αριθμητική τιμή."

msgid "plugins.generic.betterPassword.manager.settings.betterPasswordLockSecondsNumberRequired"
msgstr "Ο αριθμός δευτερολέπτων για το κλείδωμα ενός λογαριασμού μετά από υπερβολικές εσφαλμένες προσπάθειες σύνδεσης πρέπει να είναι αριθμητική τιμή."

msgid "plugins.generic.betterPassword.manager.settings.betterPasswordInvalidationTitle"
msgstr "Ακύρωση κωδικού πρόσβασης"

msgid "plugins.generic.betterPassword.manager.settings.betterPasswordInvalidationDays"
msgstr "Αριθμός ημερών πριν τη λήξη των κωδικών πρόσβασης."

msgid "plugins.generic.betterPassword.manager.settings.betterPasswordInvalidationMininumWarningDays"
msgstr "Αριθμός ημερών πριν τη λήξη, από τις οποίες θα ξεκινήσει η καθημερινή ειδοποίηση του χρήστη σχετικά με τη λήξη του κωδικού πρόσβασης."

msgid "plugins.generic.betterPassword.manager.settings.betterPasswordInvalidationPasswords"
msgstr "Αριθμός των τελευταίων κωδικών πρόσβασης που πρέπει να αποκλειστούν από επαναχρησιμοποίηση."

msgid "plugins.generic.betterPassword.manager.settings.betterPasswordInvalidationDaysNumberRequired"
msgstr "Ο αριθμός ημερών πριν τη λήξη των κωδικών πρόσβασης πρέπει να είναι αριθμητική τιμή."

msgid "plugins.generic.betterPassword.manager.settings.betterPasswordInvalidationPasswordsNumberRequired"
msgstr "Ο αριθμός των τελευταίων κωδικών πρόσβασης που πρέπει να αποκλειστούν από επαναχρησιμοποίηση πρέπει να είναι αριθμητική τιμή."

msgid "plugins.generic.betterPassword.manager.settings.betterPasswordInvalidationMininumWarningDaysNumberRequired"
msgstr "Ο αριθμός ημερών πριν τη λήξη, από τις οποίες θα ξεκινήσει η καθημερινή ειδοποίηση του χρήστη σχετικά με τη λήξη του κωδικού πρόσβασης, πρέπει να είναι αριθμητική τιμή."

msgid "plugins.generic.betterPassword.message.yourPasswordWillExpire"
msgstr "Ο κωδικός πρόσβασής σας θα λήξει σε {$days} ημέρα(ες)."

msgid "plugins.generic.betterPassword.actions.deleteBlocklist"
msgstr "Διαγραφή υπάρχουσας λίστας αποκλεισμού"

msgid "plugins.generic.betterPassword.actions.deleteBlocklistCheck"
msgstr "Είστε σίγουροι ότι θέλετε να διαγράψετε;"
