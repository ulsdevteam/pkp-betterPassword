msgid ""
"plugins.generic.betterPassword.manager.settings.betterPasswordLockTitle"
msgstr "Tijdelijke accountvergrendeling"

msgid ""
"plugins.generic.betterPassword.manager.settings.betterPasswordLockTries"
msgstr ""
"Aantal mislukte aanmeldingspogingen waarna een account wordt vergrendeld."

msgid ""
"plugins.generic.betterPassword.manager.settings.betterPasswordLockExpires"
msgstr "Aantal seconden voordat mislukte aanmeldingspogingen worden vergeten."

msgid ""
"plugins.generic.betterPassword.manager.settings.betterPasswordLockSeconds"
msgstr ""
"Aantal seconden om een account te vergrendelen na buitensporig veel mislukte"
