msgid "plugins.generic.betterPassword.displayName"
msgstr "Betere wachtwoordplug-in"

msgid "plugins.generic.betterPassword.description"
msgstr ""
"Schakel aanvullende wachtwoordvereisten in PKP-software in. Staat "
"implementatie van NIST-aanbevelingen toe."

msgid "plugins.generic.betterPassword.validation.betterPasswordCheckAlpha"
msgstr "Uw wachtwoord vereist een alfabetisch teken."

msgid "plugins.generic.betterPassword.validation.betterPasswordCheckUppercase"
msgstr "Uw wachtwoord vereist een hoofdletter."

msgid "plugins.generic.betterPassword.validation.betterPasswordCheckLowercase"
msgstr "Uw wachtwoord vereist een kleine letter."

msgid "plugins.generic.betterPassword.validation.betterPasswordCheckNumber"
msgstr "Uw wachtwoord vereist een numeriek teken."

msgid "plugins.generic.betterPassword.validation.betterPasswordCheckSpecial"
msgstr "Uw wachtwoord vereist een niet-alfanumeriek teken."

msgid "plugins.generic.betterPassword.validation.betterPasswordCheckBlocklist"
msgstr ""
"Uw wachtwoord is gevonden in een blocklist met bekende slechte wachtwoorden."

msgid "plugins.generic.betterPassword.validation.betterPasswordLocked"
msgstr ""
"Uw account is tijdelijk vergrendeld vanwege mislukte wachtwoordpogingen."

msgid ""
"plugins.generic.betterPassword.validation.betterPasswordUnexpectedError"
msgstr ""
"Uw wachtwoord kan op dit moment niet worden gewijzigd. Probeer het later "
"opnieuw."

msgid "plugins.generic.betterPassword.validation.betterPasswordPasswordReused"
msgstr ""
"U kunt dit wachtwoord niet opnieuw gebruiken. Kies alstublieft een ander."

msgid "plugins.generic.betterPassword.manager.settings"
msgstr "Instellingen"

msgid ""
"plugins.generic.betterPassword.manager.settings.betterPasswordUploadFail"
msgstr "Fout bij uploaden van bestand"

msgid ""
"plugins.generic.betterPassword.manager.settings.betterPasswordDeleteFail"
msgstr "Fout bij verwijderen van bestand"

msgid "plugins.generic.betterPassword.manager.betterPasswordSettings"
msgstr "Betere wachtwoordinstellingen"

msgid "plugins.generic.betterPassword.manager.settings.description"
msgstr ""
"<p>Met deze plugin ingeschakeld, worden gebruikerswachtwoorden gecontroleerd"
" aan de hand van aanvullende criteria om betere wachtwoordselectie te "
"garanderen. NIST raadt aan om wachtwoorden te controleren tegen een "
"blocklist en tijdelijke accountvergrendeling te gebruiken na herhaalde "
"wachtwoordfouten. Complexiteitsvereisten, inclusief specifieke soorten "
"alfanumerieke tekens, zijn beschikbaar maar niet aanbevolen om redenen van "
"UX.</p>"

msgid ""
"plugins.generic.betterPassword.manager.settings.betterPasswordCheckTitle"
msgstr "Wachtwoordvereisten"

msgid ""
"plugins.generic.betterPassword.manager.settings.betterPasswordBlocklist"
msgstr "Het blocklistbestand uploaden"

msgid ""
